# 复制为 .env 后填写。.env 不提交到 git。

# ---------- 服务 ----------
PORT=3001
# H5 访问地址（用于 CORS 和分享链接）。真机调试时改为 http://<电脑局域网 IP>:5173
H5_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aicreative:aicreative@localhost:5432/aicreative
REDIS_URL=redis://localhost:6379
# 开发用简易登录（生产环境必须关闭）
DEV_LOGIN_ENABLED=true

# ---------- 存储（S3 兼容）----------
# 本地开发：MinIO（docker compose 启动）。生产：阿里云 OSS，例如 https://oss-cn-hangzhou.aliyuncs.com
S3_ENDPOINT=http://localhost:9000
# 浏览器访问用的地址（签名下载链接用它生成）。真机调试时改为 http://<电脑局域网 IP>:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-creative
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO 需要 true；阿里云 OSS 用 false（虚拟主机风格）
S3_FORCE_PATH_STYLE=true
# 发给模型的图片怎么传：base64（本地开发，模型访问不到本机存储）或 signed_url（上线后，存储公网可达）
MODEL_IMAGE_TRANSPORT=base64

# ---------- 模型组合 ----------
# 新建项目使用的视频模型与图片模型（键名见 apps/server/src/providers/registry.ts）。
# 组合记录在项目上：改这里只影响之后新建的项目，已有项目继续用创建时的组合（D-46）。
#   gemini-omni-1.2-flash + nano-banana-2.1   Google Gemini API（海外，默认）
#   seedance-2.5 + seedream-5.0-pro           火山方舟 / BytePlus
# Seedance 只信任同账号 Seedream 生成的人物图，不要把 Seedance 和 Nano Banana 配在一起。
VIDEO_MODEL=gemini-omni-1.2-flash
IMAGE_MODEL=nano-banana-2.1
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_TASK_TIMEOUT_MS=1800000

# ---------- Google Gemini API（Gemini Omni 视频、Nano Banana 图片）----------
# 在 Google AI Studio 创建；需要开通付费
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
OMNI_MODEL_ID=gemini-omni-1.2-flash
NANO_BANANA_MODEL_ID=gemini-nano-banana-2.1
# 并发与每分钟请求数按账号实际额度填写
GEMINI_VIDEO_MAX_CONCURRENCY=3
GEMINI_VIDEO_RPM=30

# ---------- 火山方舟 / BytePlus（Seedance 视频、Seedream 图片）----------
# 国内：https://ark.cn-beijing.volces.com/api/v3
# 海外 BytePlus ModelArk：https://ark.ap-southeast.bytepluses.com/api/v3（模型 ID 以 BytePlus 控制台为准）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_ID=doubao-seedance-2-5-260628
SEEDREAM_MODEL_ID=doubao-seedream-5-0-pro-260628
# 个人账号：并发 3、RPM 180
ARK_VIDEO_MAX_CONCURRENCY=3
ARK_VIDEO_RPM=180

# ---------- 大模型（素材理解、故事线、故事板、对话修改、质检）----------
# deepseek = DeepSeek 官方 API；ark = 火山方舟托管的 DeepSeek（用上面的 ARK_*）；
# openai_compatible = 任意 OpenAI 兼容接口，填写下面的 LLM_*（必须是能看图的模型）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ARK_LLM_MODEL=deepseek-v4-1-flash-261017
# 例：Gemini 的 OpenAI 兼容接口（未实测）
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<Gemini API Key>
#   LLM_MODEL=gemini-3.8-flash
#   LLM_THINKING_PARAM=reasoning_effort
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 思考开关写法：deepseek | reasoning_effort | none
LLM_THINKING_PARAM=none
# JSON 输出：json_object | none（none 时只靠提示词，结果仍会校验）
LLM_JSON_MODE=json_object

# 虚拟人像清单（只用于 Seedance：在火山控制台开通虚拟人像库后，把挑好的素材 ID 写进这个文件；文件不存在时不显示“换虚拟人像”）
VIRTUAL_PORTRAITS_FILE=config/virtual-portraits.json
