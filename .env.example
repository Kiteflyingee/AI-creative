# 复制为 .env 后填写；供应商凭据只放服务端，.env 不提交到 git。

# ---------- 服务 ----------
PORT=3001
# 真机调试时改为 http://<电脑局域网 IP>:5173
H5_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aicreative:aicreative@localhost:5432/aicreative
REDIS_URL=redis://localhost:6379
DEV_LOGIN_ENABLED=true

# ---------- 存储（S3 兼容）----------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-creative
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO=true；生产阿里云 OSS=false，并配置公网地址
S3_FORCE_PATH_STYLE=true
# base64 适合本地开发；signed_url 要求模型可访问存储公网地址
MODEL_IMAGE_TRANSPORT=base64

# ---------- 模型组合 ----------
# 新建项目绑定组合，修改后只影响新项目，不自动换模型。
# Vertex（默认）：vertex-gemini-omni-1.2-flash + vertex-nano-banana-2.1
# 火山：seedance-2.5 + seedream-5.0-pro
# Seedance 人物图须来自同账号 Seedream，不与 Nano Banana 混配。
VIDEO_MODEL=vertex-gemini-omni-1.2-flash
IMAGE_MODEL=vertex-nano-banana-2.1
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_TASK_TIMEOUT_MS=1800000

# ---------- Google Cloud Vertex AI（ADC，全局端点）----------
# 填写绑定额度、已启用 Vertex AI API 的 Google Cloud 项目 ID。
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# 本地：gcloud auth application-default login
# 部署：使用绑定服务账号 / Workload Identity，或设置 GOOGLE_APPLICATION_CREDENTIALS 文件路径。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# 不需要 Gemini API / AI Studio Key，也不需要 Vercel Gateway Key。
VERTEX_LLM_MODEL=gemini-4-hydrogen
VERTEX_OMNI_MODEL_ID=gemini-omni-1.2-flash
VERTEX_IMAGE_MODEL_ID=gemini-nano-banana-2.1
VERTEX_API_REVISION=2026-05-20
VERTEX_VIDEO_MAX_CONCURRENCY=3
VERTEX_VIDEO_RPM=30

# ---------- 多模态大模型（AI SDK 显式 Provider 直连）----------
# vertex / deepseek / ark / openai_compatible；必须选择支持看图的模型。
LLM_PROVIDER=vertex
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ARK_LLM_MODEL=deepseek-v4-1-flash-261017
# 通义、Kimi 等兼容接口：填写供应商对应地域的完整 API 前缀、密钥、模型 ID。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 兼容接口思考参数：deepseek / reasoning_effort / none
LLM_THINKING_PARAM=none
# 只作用于兼容接口；Vertex 总是请求 JSON，业务侧仍统一经过 zod 校验。
LLM_JSON_MODE=json_object

# ---------- 火山方舟 / BytePlus ----------
# 国内方舟地址如下；海外 BytePlus 使用对应账号地址、密钥和模型 ID。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_ID=doubao-seedance-2-5-260628
SEEDREAM_MODEL_ID=doubao-seedream-5-0-pro-260628
ARK_VIDEO_MAX_CONCURRENCY=3
ARK_VIDEO_RPM=180
VIRTUAL_PORTRAITS_FILE=config/virtual-portraits.json
