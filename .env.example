# 复制为 .env 后填写。.env 不提交到 git。

# ---------- 服务 ----------
PORT=3001
# H5 访问地址（用于 CORS 和分享链接）。真机调试时改为 http://<电脑局域网 IP>:5173
H5_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aicreative:aicreative@localhost:5432/aicreative
REDIS_URL=redis://localhost:6379
# 开发用简易登录（生产环境必须关闭）
DEV_LOGIN_ENABLED=true

# ---------- 存储（S3 兼容）----------
# 本地开发：MinIO（docker compose 启动）。生产：阿里云 OSS，例如 https://oss-cn-hangzhou.aliyuncs.com
S3_ENDPOINT=http://localhost:9000
# 浏览器访问用的地址（签名下载链接用它生成）。真机调试时改为 http://<电脑局域网 IP>:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-creative
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO 需要 true；阿里云 OSS 用 false（虚拟主机风格）
S3_FORCE_PATH_STYLE=true
# 发给模型的图片怎么传：base64（本地开发，模型访问不到本机存储）或 signed_url（上线后，存储公网可达）
MODEL_IMAGE_TRANSPORT=base64

# ---------- 大模型（DeepSeek）----------
# deepseek = DeepSeek 官方 API；ark = 火山方舟托管的 DeepSeek
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ARK_LLM_MODEL=deepseek-v4-1-flash-261017

# ---------- 火山方舟（Seedance 视频、Seedream 图片）----------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 系统使用的模型（键名见 apps/server/src/providers/registry.ts）
VIDEO_MODEL=seedance-2.5
IMAGE_MODEL=seedream-5.0-pro
SEEDANCE_MODEL_ID=doubao-seedance-2-5-260628
SEEDREAM_MODEL_ID=doubao-seedream-5-0-pro-260628
# 个人账号：并发 3、RPM 180
VIDEO_MAX_CONCURRENCY=3
VIDEO_RPM=180
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_TASK_TIMEOUT_MS=1800000

# 虚拟人像清单（在火山控制台开通虚拟人像库后，把挑好的素材 ID 写进这个文件；文件不存在时不显示“换虚拟人像”）
VIRTUAL_PORTRAITS_FILE=config/virtual-portraits.json
