{
  "name": "@ai-creative/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:render": "RUN_RENDER_TEST=1 jest --runInBand render.int",
    "db:migrate": "node scripts/prisma.js migrate dev",
    "db:generate": "prisma generate",
    "inspect": "node -r ts-node/register/transpile-only src/cli/inspect.ts",
    "smoke:real": "node -r ts-node/register/transpile-only src/cli/smoke-real.ts",
    "postinstall": "prisma generate",
    "db:deploy": "node scripts/prisma.js migrate deploy"
  },
  "dependencies": {
    "@ai-creative/composition": "0.1.0",
    "@ai-creative/shared": "0.1.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@prisma/client": "6.19.3",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "bullmq": "5.81.5",
    "dotenv": "^17.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "remotion": "4.0.542",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.9",
    "@types/express": "^5.0.5",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2"
  }
}
